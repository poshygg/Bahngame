# preview = local sample cards on web, Windows and mobile; no ad requests.
# test = Google test banners in a native development build; local cards on web.
# live = configured publisher units, gated on the platform consent flow.
# off = no placements.
EXPO_PUBLIC_ADS_MODE=preview
EXPO_PUBLIC_ADSENSE_CLIENT=
EXPO_PUBLIC_ADSENSE_EXPLORE_SLOT=
EXPO_PUBLIC_ADSENSE_RESULT_SLOT=
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=
EXPO_PUBLIC_ADMOB_IOS_BANNER=
