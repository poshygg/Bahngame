{
  "expo": {
    "name": "Bahnreise",
    "slug": "bahnreise",
    "version": "0.5.0",
    "orientation": "default",
    "icon": "./assets/bahnreise-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bahnreise.game"
    },
    "android": {
      "package": "com.bahnreise.game",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/bahnreise-adaptive.png",
        "backgroundColor": "#213183"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Bahnreise",
      "shortName": "Bahnreise",
      "favicon": "./assets/bahnreise-icon.png",
      "description": "Small keystrokes. Grand adventures. A European railway typing game."
    },
    "plugins": [
      "expo-font"
    ],
    "scheme": "bahnreise",
    "backgroundColor": "#F6F5F4"
  }
}
